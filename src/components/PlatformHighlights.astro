---
/**
 * PlatformHighlights.astro
 *
 * Reusable "explore the platform" showcase for the Solutions persona pages.
 * A 2-up product card grid pointing into each /platform/* page — visually
 * distinct from the horizontal "Explore other solutions" persona list.
 *
 * Products are baked in (single source for the platform pages). Optional
 * eyebrow/heading props let a host page reframe the section.
 */
interface Props {
  eyebrow?: string;
  heading?: string;
  subhead?: string;
}

const {
  eyebrow = 'The platform',
  heading = 'Explore the full Payerset platform',
  subhead = 'One dataset, two ways to work with it — self-service analysis or delivered straight into your own environment.',
} = Astro.props;

const products = [
  {
    name: 'Rate Explorer',
    tm: true,
    href: '/platform/rate-explorer',
    desc: 'Analyze every negotiated rate by payer, provider, and code — self-service, no data lift.',
    icon: '<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.7" d="M21 21l-4.35-4.35M17 10.5a6.5 6.5 0 11-13 0 6.5 6.5 0 0113 0zM7.5 10.5h1.8m0 0V8.7m0 1.8l2.1 2.1m0 0h1.8m-1.8 0v1.8" /></svg>',
  },
  {
    name: 'Data Lake',
    tm: true,
    href: '/platform/data-lake',
    desc: 'Enriched, normalized rate and claims data delivered to your environment via API or data share.',
    icon: '<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.7" d="M4 6c0 1.66 3.58 3 8 3s8-1.34 8-3-3.58-3-8-3-8 1.34-8 3z" /><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.7" d="M4 6v6c0 1.66 3.58 3 8 3s8-1.34 8-3V6M4 12v6c0 1.66 3.58 3 8 3s8-1.34 8-3v-6" /></svg>',
  },
];
---

<section class="relative py-20 lg:py-28 overflow-hidden bg-slate-50">
  <div class="absolute top-0 inset-x-0 h-px bg-gradient-to-r from-transparent via-brand-secondary/20 to-transparent"></div>
  <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_top_center,rgba(0,146,202,0.04),transparent_60%)]"></div>
  <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="max-w-3xl mb-12" data-reveal>
      <p class="text-xs font-semibold uppercase tracking-[2.5px] text-brand-primary mb-4">{eyebrow}</p>
      <h2 class="text-3xl sm:text-4xl font-semibold text-text-primary">{heading}</h2>
      {subhead && <p class="mt-4 text-lg text-text-secondary font-light">{subhead}</p>}
    </div>

    <div class="grid sm:grid-cols-2 gap-6 max-w-4xl">
      {products.map((product, i) => (
        <a
          href={product.href}
          class="group relative flex flex-col rounded-xl border border-slate-200/70 bg-white p-6 shadow-sm overflow-hidden hover:shadow-lg hover:shadow-brand-primary/5 hover:border-brand-primary/25 hover:-translate-y-0.5 transition-all duration-300"
          data-reveal
          data-reveal-delay={String(i * 80)}
        >
          <span class="absolute inset-x-0 top-0 h-1 bg-gradient-to-r from-brand-primary to-brand-secondary scale-x-0 group-hover:scale-x-100 origin-left transition-transform duration-300"></span>
          <span
            class="inline-flex items-center justify-center w-12 h-12 rounded-lg bg-gradient-to-br from-brand-primary/15 to-brand-secondary/10 text-brand-primary ring-1 ring-brand-primary/10 mb-4"
            set:html={product.icon}
          ></span>
          <h3 class="text-lg font-semibold text-text-primary mb-2">
            {product.name}{product.tm && <sup class="text-[0.5em] align-super font-normal">&trade;</sup>}
          </h3>
          <p class="text-sm text-text-secondary font-light leading-relaxed flex-1">{product.desc}</p>
          <span class="mt-4 inline-flex items-center gap-1.5 text-sm font-semibold text-brand-primary">
            Explore
            <svg class="w-4 h-4 transition-transform group-hover:translate-x-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
            </svg>
          </span>
        </a>
      ))}
    </div>
  </div>
</section>
