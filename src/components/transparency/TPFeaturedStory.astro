---
/**
 * Large "this month's analysis" card — the newest piece, led by its own
 * designed graphic. Dark panel so posts whose graphics sit on a dark
 * background (e.g. the contract-structures Venn) blend seamlessly.
 */
interface Props {
  kicker: string;
  seriesLabel?: string;
  title: string;
  description: string;
  statNumber?: string;
  statLabel?: string;
  image?: string;
  href: string;
  ctaLabel?: string;
}

const {
  kicker,
  seriesLabel,
  title,
  description,
  statNumber,
  statLabel,
  image,
  href,
  ctaLabel = 'Read the analysis',
} = Astro.props;
---

<a
  class="group grid md:grid-cols-12 bg-brand-dark-deep rounded-2xl border border-white/10 overflow-hidden transition-shadow duration-300 hover:shadow-xl no-underline text-inherit"
  href={href}
>
  <!-- Left: the post's own designed graphic -->
  <div class="md:col-span-6 relative bg-brand-dark-deep overflow-hidden min-h-[240px] md:min-h-[380px] flex items-center justify-center">
    <div class="absolute -top-16 -right-16 w-56 h-56 bg-brand-accent/10 rounded-full blur-3xl pointer-events-none"></div>
    {image && (
      <img
        src={image}
        alt={title}
        class="relative w-full h-full object-contain md:object-cover"
        loading="eager"
      />
    )}
  </div>

  <!-- Right: editorial copy + pulled stat -->
  <div class="md:col-span-6 p-8 md:p-11 flex flex-col justify-center">
    <div class="flex flex-wrap items-center gap-2.5 mb-5">
      <span class="inline-flex items-center gap-2 text-[0.72rem] font-semibold uppercase tracking-wider text-brand-accent">
        <span class="relative flex h-1.5 w-1.5">
          <span class="absolute inline-flex h-full w-full rounded-full bg-brand-accent opacity-75 animate-ping"></span>
          <span class="relative inline-flex h-1.5 w-1.5 rounded-full bg-brand-accent"></span>
        </span>
        {kicker}
      </span>
      {seriesLabel && (
        <span class="text-[0.72rem] font-medium text-white/45 border-l border-white/15 pl-2.5">{seriesLabel}</span>
      )}
    </div>

    <h2 class="font-heading text-2xl md:text-[1.75rem] font-semibold leading-snug tracking-tight text-white mb-4">
      {title}
    </h2>

    {statNumber && (
      <div class="flex items-center gap-3 mb-4">
        <span class="font-heading text-4xl md:text-5xl font-bold text-brand-accent leading-none shrink-0">{statNumber}</span>
        {statLabel && <span class="text-sm text-slate-300 leading-snug">{statLabel}</span>}
      </div>
    )}

    <p class="text-sm text-slate-400 leading-relaxed mb-6 max-w-md">
      {description}
    </p>

    <span class="inline-flex items-center gap-2 text-sm font-semibold text-white group-hover:gap-3 transition-all duration-200">
      {ctaLabel}
      <svg width="15" height="15" viewBox="0 0 14 14" fill="none" aria-hidden="true" class="text-brand-accent">
        <path d="M2.5 7h9M8 3.5L11.5 7 8 10.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
    </span>
  </div>
</a>
