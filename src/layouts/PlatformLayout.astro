---
/**
 * PlatformLayout.astro
 *
 * Shared template for net-new Platform product pages (AI Analyst, MCP) so they
 * read as a family with the Solutions pages. Content for these products is
 * provisional — the layout keeps the copy structured and easy to firm up later.
 *
 * Template shape (see docs/site-expansion-plan.md §4b):
 *   Hero → What it is → Key capabilities → Who it's for (cross-link to Solutions)
 *   → FAQ → CTA (with pricing pointer)
 */
import PageLayout from './PageLayout.astro';
import FaqAccordion from '../components/FaqAccordion.astro';
import { buildFaqSchema, type FaqItem } from '../utils/faq';

export interface Audience {
  label: string;
  href: string;
  desc: string;
}

interface Props {
  /** SEO */
  title: string;
  description: string;
  /** Product name, e.g. "AI Analyst". */
  product: string;
  /** Optional status pill in the hero (e.g. "Coming soon", "In preview"). */
  badge?: string;
  /** Hero headline + subhead. */
  headline: string;
  subhead: string;
  /** Secondary hero CTA (primary is always Get started). */
  secondaryCta?: { label: string; href: string };
  /** "What it is" lead section. */
  intro: { heading: string; body: string };
  /** Key capabilities grid. */
  capabilities: { title: string; desc: string }[];
  /** Who it's for — cross-links back to Solutions personas. */
  audiences: Audience[];
  /** Product FAQ (also feeds FAQPage schema). */
  faqs: FaqItem[];
  /** Closing CTA copy. */
  ctaHeadline?: string;
  ctaBody?: string;
}

const {
  title,
  description,
  product,
  badge,
  headline,
  subhead,
  secondaryCta,
  intro,
  capabilities,
  audiences,
  faqs,
  ctaHeadline = 'Be first to know',
  ctaBody = `Request a demo and we'll show you ${product} as soon as it's ready.`,
} = Astro.props;

const softwareSchema = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: `Payerset ${product}`,
  applicationCategory: 'BusinessApplication',
  operatingSystem: 'Web',
  description,
  url: `https://www.payerset.com${Astro.url.pathname.replace(/\/$/, '')}`,
  offers: { '@type': 'Offer', url: 'https://www.payerset.com/get-started' },
  provider: { '@id': 'https://www.payerset.com/#organization' },
};
---

<PageLayout title={title} description={description} extraSchema={[softwareSchema, buildFaqSchema(faqs)]}>
  <!-- Hero -->
  <section class="relative overflow-hidden bg-brand-dark-deep">
    <div class="absolute inset-0 bg-gradient-to-br from-brand-dark-deep via-brand-dark to-brand-dark-deeper"></div>
    <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_top_right,rgba(0,146,202,0.15),transparent_60%)]"></div>
    <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_bottom_left,rgba(0,183,253,0.08),transparent_50%)]"></div>

    <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-24 lg:py-32">
      <div class="max-w-3xl">
        <div class="flex items-center gap-3 mb-3">
          <p class="text-sm font-semibold text-brand-secondary uppercase tracking-wider">
            {product}
          </p>
          {badge && (
            <span class="inline-flex items-center rounded-full border border-white/20 px-3 py-0.5 text-xs font-medium text-slate-300">
              {badge}
            </span>
          )}
        </div>
        <h1 class="text-3xl sm:text-4xl lg:text-5xl font-semibold text-white leading-tight">
          {headline}
        </h1>
        <h2 class="mt-6 text-lg text-slate-100 max-w-2xl font-light">
          {subhead}
        </h2>
        <div class="mt-8 flex flex-col sm:flex-row gap-4">
          <a
            href="/get-started"
            class="inline-flex items-center justify-center px-6 py-3 text-base font-semibold text-brand-dark-deep bg-white hover:bg-slate-100 rounded-lg transition-colors"
          >
            Request your demo today
          </a>
          {secondaryCta && (
            <a
              href={secondaryCta.href}
              class="inline-flex items-center justify-center px-6 py-3 text-base font-semibold text-white border border-white/30 hover:border-white/60 hover:bg-white/5 rounded-lg transition-colors"
            >
              {secondaryCta.label}
            </a>
          )}
        </div>
      </div>
    </div>
  </section>

  <!-- What it is -->
  <section class="relative py-20 lg:py-28 overflow-hidden bg-white">
    <div class="absolute top-0 inset-x-0 h-px bg-gradient-to-r from-transparent via-brand-secondary/20 to-transparent"></div>
    <div class="relative max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 text-center" data-reveal>
      <p class="text-xs font-semibold uppercase tracking-[2.5px] text-brand-primary mb-4">What it is</p>
      <h2 class="text-3xl sm:text-4xl font-semibold text-text-primary mb-6">
        {intro.heading}
      </h2>
      <p class="text-lg text-text-secondary leading-relaxed font-light">
        {intro.body}
      </p>
    </div>
  </section>

  <!-- Key capabilities -->
  <section class="relative py-20 lg:py-28 overflow-hidden bg-slate-50">
    <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_top_center,rgba(0,146,202,0.04),transparent_60%)]"></div>
    <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl mb-14" data-reveal>
        <p class="text-xs font-semibold uppercase tracking-[2.5px] text-brand-primary mb-4">Key capabilities</p>
        <h2 class="text-3xl sm:text-4xl font-semibold text-text-primary">
          Built on the most complete transparency dataset
        </h2>
      </div>

      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
        {capabilities.map((cap, i) => (
          <div
            class="bg-white/80 backdrop-blur-sm rounded-xl border border-slate-200/60 shadow-sm p-6 hover:shadow-lg hover:shadow-brand-primary/5 hover:border-brand-primary/25 transition-all duration-300"
            data-reveal
            data-reveal-delay={String(i * 80)}
          >
            <div class="inline-flex items-center justify-center w-12 h-12 rounded-lg bg-gradient-to-br from-brand-primary/15 to-brand-secondary/10 text-brand-primary mb-4 ring-1 ring-brand-primary/10">
              <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M13 10V3L4 14h7v7l9-11h-7z" />
              </svg>
            </div>
            <h3 class="text-lg font-semibold text-text-primary mb-2">{cap.title}</h3>
            <p class="text-sm text-text-secondary leading-relaxed font-light">{cap.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Who it's for -->
  <section class="relative py-20 lg:py-28 overflow-hidden bg-white">
    <div class="absolute top-0 inset-x-0 h-px bg-gradient-to-r from-transparent via-brand-secondary/20 to-transparent"></div>
    <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl mb-14" data-reveal>
        <p class="text-xs font-semibold uppercase tracking-[2.5px] text-brand-primary mb-4">Who it's for</p>
        <h2 class="text-3xl sm:text-4xl font-semibold text-text-primary">
          Made for the way you work
        </h2>
      </div>

      <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-6">
        {audiences.map((aud, i) => (
          <a
            href={aud.href}
            class="group flex flex-col bg-white/80 backdrop-blur-sm rounded-xl border border-slate-200/60 shadow-sm p-6 hover:shadow-lg hover:shadow-brand-primary/5 hover:border-brand-primary/25 transition-all duration-300"
            data-reveal
            data-reveal-delay={String(i * 80)}
          >
            <h3 class="text-base font-semibold text-text-primary mb-2">{aud.label}</h3>
            <p class="text-sm text-text-secondary leading-relaxed font-light flex-1">{aud.desc}</p>
            <span class="mt-4 inline-flex items-center gap-1.5 text-sm font-semibold text-brand-primary group-hover:text-brand-primary-hover transition-colors">
              Learn more
              <svg class="w-4 h-4 transition-transform group-hover:translate-x-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
              </svg>
            </span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="relative py-20 lg:py-28 bg-slate-50">
    <div class="absolute top-0 inset-x-0 h-px bg-gradient-to-r from-transparent via-brand-secondary/20 to-transparent"></div>
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-12" data-reveal>
        <p class="text-xs font-semibold uppercase tracking-[2.5px] text-brand-primary mb-4">Common questions</p>
        <h2 class="text-3xl sm:text-4xl font-semibold text-brand-dark">
          Frequently Asked Questions
        </h2>
      </div>
      <FaqAccordion faqs={faqs} reveal />
    </div>
  </section>

  <!-- CTA bookend -->
  <section class="relative overflow-hidden bg-brand-dark-deep">
    <div class="absolute inset-0 bg-gradient-to-tl from-brand-dark-deep via-brand-dark to-brand-dark-deeper"></div>
    <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_bottom_right,rgba(0,146,202,0.15),transparent_60%)]"></div>
    <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_top_left,rgba(0,183,253,0.08),transparent_50%)]"></div>

    <div class="relative max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 py-20 lg:py-28 text-center" data-reveal>
      <h2 class="text-3xl sm:text-4xl font-semibold text-white mb-4">
        {ctaHeadline}
      </h2>
      <p class="text-lg text-white/90 mb-8 font-light">
        {ctaBody}
      </p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a
          href="/get-started"
          class="inline-flex items-center justify-center px-8 py-4 text-base font-semibold text-brand-dark-deep bg-white hover:bg-slate-100 rounded-lg transition-colors"
        >
          Request a demo
        </a>
        <a
          href="/pricing"
          class="inline-flex items-center justify-center px-8 py-4 text-base font-semibold text-white border border-white/30 hover:border-white/60 hover:bg-white/5 rounded-lg transition-colors"
        >
          View pricing
        </a>
      </div>
    </div>
  </section>
</PageLayout>
