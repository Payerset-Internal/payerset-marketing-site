---
import { topics as topicConfig } from '../../config/transparency-topics';
import TPFeaturedStory from './TPFeaturedStory.astro';
import TPSpotlightCard from './TPSpotlightCard.astro';
import TPFeedCard from './TPFeedCard.astro';

interface FeedItem {
  tag: string;
  tagType: 'newsletter' | 'brief' | 'research';
  title: string;
  description: string;
  meta: string;
  href: string;
  date: Date;
  topics: string[];
  image?: string;
  cardImage?: string;
  statNumber?: string;
  statLabel?: string;
  seriesLabel?: string;
}

interface Props {
  feedItems: FeedItem[];
  scorecard: {
    tag: string;
    title: string;
    description: string;
    href: string;
  };
}

const { feedItems, scorecard } = Astro.props;

const allItems = [...feedItems].sort((a, b) => b.date.getTime() - a.date.getTime());

// Tier 1/2: the newest piece leads; the next fills the spotlight row beside
// the evergreen scorecard.
const featured = allItems[0];
const spotlight = allItems[1];

const monthYear = (d: Date) => d.toLocaleDateString('en-US', { month: 'long', year: 'numeric' });
const topicLabel = (item?: FeedItem) =>
  topicConfig.find(t => t.slug === item?.topics[0])?.shortLabel ?? 'Analysis';

// A short scorecard title for the compact spotlight card.
const scorecardTitle = scorecard.title.split(':')[0];

const tabs = [
  { id: 'all',      label: 'All' },
  { id: 'analysis', label: 'Analysis' },
  { id: 'policy',   label: 'Policy' },
  { id: 'playbook', label: 'Field Guides' },
  { id: 'equity',   label: 'Patient Equity' },
  { id: 'employer', label: 'Employers' },
];

function getMatchingTabs(item: FeedItem): string[] {
  return ['all', ...item.topics];
}
---

<!-- Sticky tab bar, sits below the main header (72px tall) -->
<div id="tp-tab-bar" class="sticky top-[72px] z-40 bg-white border-b border-slate-200 shadow-sm">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center gap-1 overflow-x-auto scrollbar-none py-1" role="tablist">
      {tabs.map((tab, i) => (
        <button
          role="tab"
          data-tab={tab.id}
          aria-selected={i === 0 ? 'true' : 'false'}
          class="tp-tab flex-shrink-0 px-4 py-2.5 text-sm font-medium rounded-md transition-all duration-150 whitespace-nowrap"
        >
          {tab.label}
        </button>
      ))}
    </div>
  </div>
</div>

<!-- Highlights: featured story + spotlight row. Editorial promotion, only
     shown in the "All" view; topic filters fall through to the full grid. -->
<div id="tp-highlights" class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-10">
  {featured && (
    <>
      <div class="text-[0.8rem] font-medium text-text-muted mb-5">Latest Analysis</div>
      <TPFeaturedStory
        kicker={`New · ${monthYear(featured.date)}`}
        seriesLabel={featured.seriesLabel}
        title={featured.title}
        description={featured.description}
        statNumber={featured.statNumber}
        statLabel={featured.statLabel}
        image={featured.cardImage}
        href={featured.href}
      />
    </>
  )}

  <div class="grid md:grid-cols-2 gap-5 mt-8">
    {spotlight && (
      <TPSpotlightCard
        variant="image"
        kicker={topicLabel(spotlight)}
        seriesLabel={spotlight.seriesLabel}
        title={spotlight.title}
        description={spotlight.description}
        statNumber={spotlight.statNumber}
        statLabel={spotlight.statLabel}
        image={spotlight.cardImage}
        href={spotlight.href}
      />
    )}
    <TPSpotlightCard
      variant="scorecard"
      kicker="Scorecard"
      seriesLabel="Q2 2026"
      title={scorecardTitle}
      description={scorecard.description}
      statNumber="100+"
      statLabel="payers graded on three dimensions of their machine-readable files"
      href={scorecard.href}
      ctaLabel="Explore the scorecard"
    />
  </div>
</div>

<!-- The full library -->
<section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12 pb-16">
  <div class="flex items-baseline justify-between gap-4 mb-6 pt-4 border-t border-slate-100">
    <h2 class="font-heading text-lg font-semibold text-text-primary">
      The full library
      <span id="tp-count" class="font-normal text-text-muted"></span>
    </h2>
  </div>

  <div id="tp-feed-grid" class="grid md:grid-cols-2 lg:grid-cols-3 gap-5">
    {allItems.map(item => (
      <div
        class="tp-card-wrapper"
        data-tabs={getMatchingTabs(item).join(',')}
      >
        <TPFeedCard
          title={item.title}
          description={item.description}
          meta={item.meta}
          href={item.href}
          image={item.cardImage}
          topics={item.topics}
        />
      </div>
    ))}
  </div>
  <div id="tp-empty" class="hidden text-center py-12 text-text-muted text-sm">
    No content in this topic yet. Check back soon.
  </div>
</section>

<script>
  const highlights = document.getElementById('tp-highlights');
  const feedGrid = document.getElementById('tp-feed-grid');
  const empty = document.getElementById('tp-empty');
  const count = document.getElementById('tp-count');
  const tabBtns = document.querySelectorAll<HTMLButtonElement>('[data-tab]');
  const cards = feedGrid?.querySelectorAll<HTMLElement>('.tp-card-wrapper');

  function setTab(tabId: string) {
    tabBtns?.forEach(btn => {
      btn.setAttribute('aria-selected', btn.dataset.tab === tabId ? 'true' : 'false');
    });

    if (highlights) {
      highlights.style.display = tabId === 'all' ? '' : 'none';
    }

    let visibleCount = 0;
    cards?.forEach(card => {
      const tabs = card.dataset.tabs?.split(',') ?? [];
      const show = tabs.includes(tabId);
      card.style.display = show ? '' : 'none';
      if (show) visibleCount++;
    });

    if (count) {
      const noun = visibleCount === 1 ? 'piece' : 'pieces';
      count.textContent = ` · ${visibleCount} ${noun}`;
    }

    if (empty) {
      empty.classList.toggle('hidden', visibleCount > 0);
    }
  }

  tabBtns?.forEach(btn => {
    btn.addEventListener('click', () => {
      setTab(btn.dataset.tab ?? 'all');
    });
  });

  setTab('all');
</script>

<style>
  .scrollbar-none {
    scrollbar-width: none;
  }
  .scrollbar-none::-webkit-scrollbar {
    display: none;
  }

  .tp-tab {
    color: var(--color-text-muted);
  }
  .tp-tab:hover {
    color: var(--color-text-primary);
    background-color: var(--color-slate-50);
  }
  .tp-tab[aria-selected="true"] {
    color: var(--color-brand-primary);
    background-color: var(--color-brand-primary-light);
  }
</style>
